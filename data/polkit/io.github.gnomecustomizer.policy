<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GNOME Customizer</vendor>
  <vendor_url>https://github.com/uk2010/gnome-customizer</vendor_url>
  <action id="io.github.gnomecustomizer.modify-system">
    <description>Modify the GNOME login screen</description>
    <message>Authentication is required to modify the GNOME login screen</message>
    <icon_name>io.github.gnomecustomizer</icon_name>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
</policyconfig>
